{
  "name": "ribbai-executive-manual",
  "version": "1.0.0",
  "description": "RIBBAI 2.0 Executive Manual - Premium Corporate PDF Generator",
  "main": "generate-pdf.js",
  "scripts": {
    "install-deps": "npm install",
    "generate": "node generate-pdf.js",
    "build": "npm run install-deps && npm run generate",
    "serve": "npx http-server html -p 3000 -o",
    "dev": "npm run serve",
    "clean": "rimraf pdf/*.pdf",
    "validate": "node -e \"require('./generate-pdf.js').validatePDF('./pdf/RIBBAI_2.0_EXECUTIVE_MANUAL.pdf').then(console.log)\""
  },
  "dependencies": {
    "puppeteer": "^21.11.0"
  },
  "devDependencies": {
    "http-server": "^14.1.0",
    "rimraf": "^5.0.0"
  },
  "keywords": [
    "pdf",
    "executive",
    "manual",
    "ribbai",
    "business-intelligence",
    "restaurant",
    "management"
  ],
  "author": "RIBBAI Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "."
  }
}
