    "lucide-react": "^0.468.0",
    "next": "15.1.11",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "puppeteer": "^23.11.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.4.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
