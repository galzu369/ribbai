{
  "name": "ribbai-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade restaurant operations management platform for RIBBAI",
  "author": "RIBBAI Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:studio": "prisma studio",
    "reports:consumables:monthly": "node scripts/generate-monthly-consumables-report-pdf.mjs",
    "reports:consumables:live": "node scripts/generate-monthly-consumables-live.mjs",
    "reports:inventory:update": "node scripts/generate-inventory-update-report-pdf.mjs",
    "reports:overtime:monthly": "node scripts/generate-monthly-overtime-report-pdf.mjs",
    "reports:daily:with-overtime": "node scripts/generate-daily-report-with-overtime-update.mjs",
    "reports:leaderboard:weekly": "node scripts/generate-weekly-leaderboard-report-pdf.mjs",
    "checklists:opening:pdf": "node scripts/generate-opening-checklist-pdf.mjs",
    "checklists:opening:fillable-pdf": "node scripts/generate-opening-checklist-fillable-pdf.mjs",
    "checklists:opening:all": "npm run checklists:opening:pdf && npm run checklists:opening:fillable-pdf",
    "checklists:closing:pdf": "node scripts/generate-closing-checklist-pdf.mjs",
    "checklists:closing:fillable-pdf": "node scripts/generate-closing-checklist-fillable-pdf.mjs",
    "checklists:closing:all": "npm run checklists:closing:pdf && npm run checklists:closing:fillable-pdf",
    "checklists:inventory:weekly-count": "node scripts/generate-weekly-inventory-count-sheet-pdf.mjs",
    "snapshots:weekly": "node scripts/generate-weekly-consumables-snapshot.mjs",
    "snapshots:weekly:with-update": "node scripts/run-weekly-inventory-update-with-snapshot.mjs",
    "inventory:month-close": "node scripts/run-month-close.mjs",
    "validation:inventory:continuity": "node scripts/validate-inventory-continuity-june-july.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
